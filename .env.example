# Copy to .env and change the passwords. Never commit .env.

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=shortener
MYSQL_USER=shortener
MYSQL_PASSWORD=change_me

# Host port is 3307 (see docker-compose.yml). Keep the password in sync with MYSQL_PASSWORD.
DATABASE_URL=mysql+pymysql://shortener:change_me@localhost:3307/shortener
REDIS_URL=redis://localhost:6379/0

BASE_URL=http://localhost:8000
CACHE_TTL_SECONDS=3600
CODE_LENGTH=7
